{
	"name": "@stryx/cli",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"stryx": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"start": "tsx src/cli.ts",
		"build": "tsc -b",
		"clean": "rm -rf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@stryx/core": "workspace:*",
		"@stryx/domain": "workspace:*"
	}
}
